"""Exhaustive live API test suite — all endpoints, filters, pagination, keys, errors."""

import httpx
import json
import sys

BASE = "http://localhost:8050"
client = httpx.Client(timeout=10)

results = {"pass": 0, "fail": 0, "tests": []}


def test(name, ok, detail=""):
    status = "PASS" if ok else "FAIL"
    results["tests"].append(f"{status}: {name} {detail}")
    if ok:
        results["pass"] += 1
    else:
        results["fail"] += 1
        print(f"  FAIL: {name} -- {detail}")


def gql(query, headers=None):
    r = client.post(f"{BASE}/graphql", json={"query": query}, headers=headers or {})
    return r.json(), r.status_code


# ============================================================
# 1. HEALTH ENDPOINT
# ============================================================
print("\n=== 1. HEALTH ENDPOINT ===")
r = client.get(f"{BASE}/health")
test("health status 200", r.status_code == 200)
d = r.json()
test("health has status=ok", d.get("status") == "ok")
test("health has version", "version" in d)

# ============================================================
# 2. ROOT REDIRECT
# ============================================================
print("\n=== 2. ROOT REDIRECT ===")
r = client.get(f"{BASE}/", follow_redirects=False)
test("root redirects", r.status_code in (307, 308, 200))

# ============================================================
# 3. DASH DASHBOARD
# ============================================================
print("\n=== 3. DASH DASHBOARD ===")
r = client.get(f"{BASE}/dash/")
test("dash loads 200", r.status_code == 200)
test("dash has ACI title", "ACI Research Tool" in r.text)

# ============================================================
# 4. BASIC GRAPHQL - health
# ============================================================
print("\n=== 4. GRAPHQL HEALTH ===")
d, sc = gql("{ health }")
test("health query 200", sc == 200)
test("health returns ok", d.get("data", {}).get("health") == "ok")
test("health no errors", "errors" not in d)

# ============================================================
# 5. COHORT NIV - all 15 fields + filters + pagination
# ============================================================
print("\n=== 5. COHORT NIV ===")
d, sc = gql(
    "{ cohortNiv { totalCount edges { node { cohortType displayName "
    "pvBenefits pvTax pvTransition pvCosts pvHousing pvHealth pvEducation "
    "pvIntegrity pvSettlement niv transitionProbability timeHorizon discountRate "
    "} cursor } pageInfo { hasNextPage hasPreviousPage startCursor endCursor } } }"
)
test("cohortNiv 200", sc == 200, str(d.get("errors")))
test("cohortNiv totalCount=8", d["data"]["cohortNiv"]["totalCount"] == 8)
test("cohortNiv 8 edges", len(d["data"]["cohortNiv"]["edges"]) == 8)
test("cohortNiv has cursors", all("cursor" in e for e in d["data"]["cohortNiv"]["edges"]))
test("cohortNiv pageInfo present", "hasNextPage" in d["data"]["cohortNiv"]["pageInfo"])

# All 15 fields on first node
node = d["data"]["cohortNiv"]["edges"][0]["node"]
for field in ["cohortType", "displayName", "pvBenefits", "pvTax", "pvTransition",
              "pvCosts", "pvHousing", "pvHealth", "pvEducation", "pvIntegrity",
              "pvSettlement", "niv", "transitionProbability", "timeHorizon", "discountRate"]:
    test(f"cohortNiv field {field}", field in node, f"missing {field}")

# filter by cohortType
d, sc = gql('{ cohortNiv(cohortType: "refugee") { totalCount edges { node { cohortType } } } }')
test("cohortNiv filter refugee count", d["data"]["cohortNiv"]["totalCount"] >= 1)
test("cohortNiv all refugee", all(e["node"]["cohortType"] == "refugee" for e in d["data"]["cohortNiv"]["edges"]))

# pagination
d1, _ = gql("{ cohortNiv(first: 3) { totalCount edges { cursor } pageInfo { endCursor hasNextPage } } }")
test("cohortNiv first=3 returns 3", len(d1["data"]["cohortNiv"]["edges"]) == 3)
test("cohortNiv hasNextPage", d1["data"]["cohortNiv"]["pageInfo"]["hasNextPage"] is True)
cursor = d1["data"]["cohortNiv"]["edges"][-1]["cursor"]
test("cohortNiv cursor present", cursor is not None)

d2, _ = gql(f'{{ cohortNiv(first: 3, after: "{cursor}") {{ edges {{ node {{ cohortType }} }} pageInfo {{ hasNextPage }} }} }}')
test("cohortNiv page2 returns data", len(d2["data"]["cohortNiv"]["edges"]) >= 1)

# empty filter
d, sc = gql('{ cohortNiv(cohortType: "nonexistent") { totalCount } }')
test("cohortNiv empty filter 0", d["data"]["cohortNiv"]["totalCount"] == 0)

# ============================================================
# 6. LAMBDA RESULTS - all 9 fields
# ============================================================
print("\n=== 6. LAMBDA RESULTS ===")
d, sc = gql(
    "{ lambdaResults { variable coefficient stdError tStatistic pValue "
    "ciLower ciUpper significant10pct notes } }"
)
test("lambdaResults 200", sc == 200, str(d.get("errors")))
lr = d["data"]["lambdaResults"]
test("lambdaResults has rows", len(lr) >= 5)
for field in ["variable", "coefficient", "stdError", "tStatistic", "pValue",
              "ciLower", "ciUpper", "significant10pct", "notes"]:
    test(f"lambdaResults field {field}", field in lr[0], f"missing {field}")

# ============================================================
# 7. WELFARE LOSS - all 8 fields + filters + pagination
# ============================================================
print("\n=== 7. WELFARE LOSS ===")
d, sc = gql(
    "{ welfareLoss { totalCount edges { node { year province actualWelfare "
    "optimalWelfare welfareLoss actualTotalIntake optimalTotalIntake intakeGap } "
    "cursor } pageInfo { hasNextPage endCursor } } }"
)
test("welfareLoss 200", sc == 200, str(d.get("errors")))
test("welfareLoss has data", d["data"]["welfareLoss"]["totalCount"] > 0)
node = d["data"]["welfareLoss"]["edges"][0]["node"]
for field in ["year", "province", "actualWelfare", "optimalWelfare",
              "welfareLoss", "actualTotalIntake", "optimalTotalIntake", "intakeGap"]:
    test(f"welfareLoss field {field}", field in node, f"missing {field}")

# filter by province
d, sc = gql('{ welfareLoss(province: "ON") { edges { node { province } } } }')
test("welfareLoss filter ON", all(e["node"]["province"] == "ON" for e in d["data"]["welfareLoss"]["edges"]))

# filter by year range
d, sc = gql("{ welfareLoss(yearMin: 2020, yearMax: 2022) { edges { node { year } } } }")
test("welfareLoss year filter", all(2020 <= e["node"]["year"] <= 2022 for e in d["data"]["welfareLoss"]["edges"]))

# combined filters
d, sc = gql('{ welfareLoss(province: "BC", yearMin: 2021, yearMax: 2023) { edges { node { province year } } } }')
test("welfareLoss combined filter", all(
    e["node"]["province"] == "BC" and 2021 <= e["node"]["year"] <= 2023
    for e in d["data"]["welfareLoss"]["edges"]
))

# pagination
d1, _ = gql("{ welfareLoss(first: 5) { edges { cursor } pageInfo { endCursor hasNextPage } } }")
test("welfareLoss pagination first=5", len(d1["data"]["welfareLoss"]["edges"]) == 5)
cursor = d1["data"]["welfareLoss"]["edges"][-1]["cursor"]
d2, _ = gql(f'{{ welfareLoss(first: 5, after: "{cursor}") {{ edges {{ node {{ year }} }} }} }}')
test("welfareLoss page2 ok", len(d2["data"]["welfareLoss"]["edges"]) >= 1)

# ============================================================
# 8. DECOMPOSITION - all 6 fields + filters
# ============================================================
print("\n=== 8. DECOMPOSITION ===")
d, sc = gql(
    "{ decomposition { totalCount edges { node { year dimension avgScore "
    "intakeGap contribution contributionPct } cursor } pageInfo { hasNextPage } } }"
)
test("decomposition 200", sc == 200, str(d.get("errors")))
test("decomposition has data", d["data"]["decomposition"]["totalCount"] > 0)
node = d["data"]["decomposition"]["edges"][0]["node"]
for field in ["year", "dimension", "avgScore", "intakeGap", "contribution", "contributionPct"]:
    test(f"decomposition field {field}", field in node, f"missing {field}")

# filter by dimension
d, sc = gql('{ decomposition(dimension: "housing_vacancy") { edges { node { dimension } } } }')
if d["data"]["decomposition"]["edges"]:
    test("decomposition filter dimension", all(
        e["node"]["dimension"] == "housing_vacancy" for e in d["data"]["decomposition"]["edges"]
    ))
else:
    test("decomposition filter dimension (empty ok)", True)

# filter by year
d, sc = gql("{ decomposition(yearMin: 2021, yearMax: 2023) { edges { node { year } } } }")
test("decomposition year filter", all(2021 <= e["node"]["year"] <= 2023 for e in d["data"]["decomposition"]["edges"]))

# ============================================================
# 9. COUNTERFACTUAL - all 8 fields + filters
# ============================================================
print("\n=== 9. COUNTERFACTUAL ===")
d, sc = gql(
    "{ counterfactual { totalCount edges { node { year province cohortType "
    "actualIntake optimalIntake aciValue nivPerUnit scenario } cursor } "
    "pageInfo { hasNextPage } } }"
)
test("counterfactual 200", sc == 200, str(d.get("errors")))
test("counterfactual has data", d["data"]["counterfactual"]["totalCount"] > 0)
node = d["data"]["counterfactual"]["edges"][0]["node"]
for field in ["year", "province", "cohortType", "actualIntake", "optimalIntake",
              "aciValue", "nivPerUnit", "scenario"]:
    test(f"counterfactual field {field}", field in node, f"missing {field}")

# filter by scenario
d, sc = gql('{ counterfactual(scenario: "aci_equal") { edges { node { scenario } } } }')
test("counterfactual filter scenario", all(
    e["node"]["scenario"] == "aci_equal" for e in d["data"]["counterfactual"]["edges"]
))

# filter by province + year
d, sc = gql('{ counterfactual(province: "BC", yearMin: 2022, yearMax: 2023) { edges { node { province year } } } }')
test("counterfactual filter province+year", all(
