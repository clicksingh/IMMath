# ============================================================
# SUMMARY
# ============================================================
sep = "=" * 60
print(f"\n{sep}")
total = results["pass"] + results["fail"]
print(f"RESULTS: {results['pass']} passed, {results['fail']} failed out of {total}")
print(sep)
if results["fail"] > 0:
    print("FAILURES:")
    for t in results["tests"]:
        if t.startswith("FAIL"):
            print(f"  {t}")
    sys.exit(1)
else:
    print("ALL TESTS PASSED")
    sys.exit(0)
