# 10. MASTER PANEL - all nested types + all fields
# ============================================================
print("\n=== 10. MASTER PANEL ===")
d, sc = gql("""
{
    masterPanel(first: 5) {
        totalCount
        edges {
            cursor
            node {
                year quarter province cohortType intakeCount
                housing { startsAnnual startsPerCapita startsPerCapitaGrowth vacancyRate avgRent2br }
                labour { unemploymentRate medianWageHourly jobVacancyRate jobQualityIndex }
                capacities { healthCapacity schoolCapacity }
                normalized { vacancyRateNorm startsGrowthNorm healthCapacityNorm schoolCapacityNorm jobQualityNorm fiscalBalanceNorm }
                aci { housingHeavy equal fiscalHeavy }
                aciNanFlag
            }
        }
        pageInfo { hasNextPage endCursor }
    }
}
""")
test("masterPanel 200", sc == 200, str(d.get("errors")))
test("masterPanel has data", d["data"]["masterPanel"]["totalCount"] > 0)
node = d["data"]["masterPanel"]["edges"][0]["node"]

# top-level fields
for field in ["year", "quarter", "province", "cohortType", "intakeCount", "aciNanFlag"]:
    test(f"masterPanel field {field}", field in node, f"missing {field}")

# housing (5 fields)
for field in ["startsAnnual", "startsPerCapita", "startsPerCapitaGrowth", "vacancyRate", "avgRent2br"]:
    test(f"masterPanel housing.{field}", field in node.get("housing", {}), f"missing {field}")

# labour (4 fields)
for field in ["unemploymentRate", "medianWageHourly", "jobVacancyRate", "jobQualityIndex"]:
    test(f"masterPanel labour.{field}", field in node.get("labour", {}), f"missing {field}")

# capacities (2 fields)
for field in ["healthCapacity", "schoolCapacity"]:
    test(f"masterPanel capacities.{field}", field in node.get("capacities", {}), f"missing {field}")

# normalized (6 fields)
for field in ["vacancyRateNorm", "startsGrowthNorm", "healthCapacityNorm",
              "schoolCapacityNorm", "jobQualityNorm", "fiscalBalanceNorm"]:
    test(f"masterPanel normalized.{field}", field in node.get("normalized", {}), f"missing {field}")

# aci (3 fields)
for field in ["housingHeavy", "equal", "fiscalHeavy"]:
    test(f"masterPanel aci.{field}", field in node.get("aci", {}), f"missing {field}")

# masterPanel filters
d, sc = gql('{ masterPanel(province: "QC", cohortType: "refugee") { edges { node { province cohortType } } } }')
test("masterPanel filter QC+refugee", all(
    e["node"]["province"] == "QC" and e["node"]["cohortType"] == "refugee"
    for e in d["data"]["masterPanel"]["edges"]
))

d, sc = gql('{ masterPanel(province: "ON") { edges { node { province } } } }')
test("masterPanel filter ON", all(e["node"]["province"] == "ON" for e in d["data"]["masterPanel"]["edges"]))

d, sc = gql("{ masterPanel(yearMin: 2022, yearMax: 2023) { edges { node { year } } } }")
test("masterPanel year filter", all(2022 <= e["node"]["year"] <= 2023 for e in d["data"]["masterPanel"]["edges"]))

# 3-filter combo
d, sc = gql('{ masterPanel(province: "BC", cohortType: "skilled", yearMin: 2020, yearMax: 2022) { edges { node { province cohortType year } } } }')
test("masterPanel 3-filter combo", all(
    e["node"]["province"] == "BC"
    and e["node"]["cohortType"] == "skilled"
    and 2020 <= e["node"]["year"] <= 2022
    for e in d["data"]["masterPanel"]["edges"]
))

# pagination
d1, _ = gql("{ masterPanel(first: 3) { totalCount edges { cursor } pageInfo { endCursor hasNextPage } } }")
test("masterPanel pagination first=3", len(d1["data"]["masterPanel"]["edges"]) == 3)
cursor = d1["data"]["masterPanel"]["edges"][-1]["cursor"]
d2, _ = gql(f'{{ masterPanel(first: 3, after: "{cursor}") {{ edges {{ node {{ year }} }} }} }}')
test("masterPanel page2 ok", len(d2["data"]["masterPanel"]["edges"]) >= 1)

