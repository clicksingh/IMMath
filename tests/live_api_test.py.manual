test("anonymous query works", sc == 200)

# Basic key
d, sc = gql("{ health }", headers={"X-API-Key": "immath_basic_dev001"})
test("basic key works", sc == 200)

# Premium key
d, sc = gql("{ health }", headers={"X-API-Key": "immath_premium_dev001"})
test("premium key works", sc == 200)

# Invalid key
d, sc = gql("{ health }", headers={"X-API-Key": "fake_key_12345"})
test("invalid key still works (anonymous)", sc == 200)

# Empty key
d, sc = gql("{ health }", headers={"X-API-Key": ""})
test("empty key works (anonymous)", sc == 200)

# Basic key with data queries
d, sc = gql("{ masterPanel(first: 1) { totalCount } }", headers={"X-API-Key": "immath_basic_dev001"})
test("basic key data query", sc == 200)

# Premium key with data queries
d, sc = gql("{ masterPanel(first: 1) { totalCount } }", headers={"X-API-Key": "immath_premium_dev001"})
test("premium key data query", sc == 200)

