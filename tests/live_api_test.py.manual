# ============================================================
# 16. PAGINATION EDGE CASES
# ============================================================
print("\n=== 16. PAGINATION EDGE CASES ===")
# first=1
d, sc = gql("{ masterPanel(first: 1) { edges { cursor } pageInfo { hasNextPage } } }")
test("first=1 returns 1 edge", len(d["data"]["masterPanel"]["edges"]) == 1)

# first=100 (max)
d, sc = gql("{ masterPanel(first: 100) { edges { cursor } } }")
test("first=100 accepted", sc == 200)

# first=200 (over max, should cap or accept)
d, sc = gql("{ masterPanel(first: 200) { edges { cursor } } }")
test("first=200 handled", sc == 200)

# Walk through ALL pages of cohortNiv
cursors_seen = set()
all_nodes = []
page = gql("{ cohortNiv(first: 3) { edges { cursor node { cohortType } } pageInfo { hasNextPage endCursor } } }")
while True:
    d = page[0]
    edges = d["data"]["cohortNiv"]["edges"]
    for e in edges:
        c = e["cursor"]
        test("no duplicate cursors", c not in cursors_seen, f"cursor={c}")
        cursors_seen.add(c)
        all_nodes.append(e["node"]["cohortType"])
    if not d["data"]["cohortNiv"]["pageInfo"]["hasNextPage"]:
        break
    cursor = d["data"]["cohortNiv"]["pageInfo"]["endCursor"]
    page = gql(f'{{ cohortNiv(first: 3, after: "{cursor}") {{ edges {{ cursor node {{ cohortType }} }} pageInfo {{ hasNextPage endCursor }} }} }}')

test("full pagination walk = 8 nodes", len(all_nodes) == 8, f"got {len(all_nodes)}")

# ============================================================
# 17. DEEP QUERY (depth limit)
# ============================================================
print("\n=== 17. DEEP QUERY ===")
deep = "{ health " * 15 + "}" * 15
d, sc = gql(deep)
test("deep query handled gracefully", sc == 200)

# ============================================================
# 18. MULTI-QUERY (all 6 models in one request)
# ============================================================
print("\n=== 18. MULTI-QUERY ===")
d, sc = gql("""
{
    health
    cohortNiv(first: 1) { totalCount }
    lambdaResults { variable }
    welfareLoss(first: 1) { totalCount }
    decomposition(first: 1) { totalCount }
    counterfactual(first: 1) { totalCount }
    masterPanel(first: 1) { totalCount }
}
""")
test("multi-query 200", sc == 200, str(d.get("errors")))
test("multi-query all 7 keys", all(
    k in d["data"]
    for k in ["health", "cohortNiv", "lambdaResults", "welfareLoss", "decomposition", "counterfactual", "masterPanel"]
))
test("multi-query health ok", d["data"]["health"] == "ok")
test("multi-query cohortNiv >0", d["data"]["cohortNiv"]["totalCount"] > 0)
test("multi-query welfareLoss >0", d["data"]["welfareLoss"]["totalCount"] > 0)
test("multi-query decomposition >0", d["data"]["decomposition"]["totalCount"] > 0)
test("multi-query counterfactual >0", d["data"]["counterfactual"]["totalCount"] > 0)
test("multi-query masterPanel >0", d["data"]["masterPanel"]["totalCount"] > 0)

